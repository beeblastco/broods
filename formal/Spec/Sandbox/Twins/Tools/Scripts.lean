/-!
Long constants copied from the TypeScript source, kept apart so the twins stay readable: the node
scripts in `glob.tool.ts`, `edit.tool.ts` and `file-operation.ts`, and the NFKD folding `memorySlug` needs.
-/

namespace Spec.Sandbox.Tools

/-- `globScript` around its two base64 arguments. -/
def globScriptParts : List String := [
  "node <<'NODEEOF'\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst pattern = Buffer.from(\"",
  "\", \"base64\").toString(\"utf8\");\nconst root = Buffer.from(\"",
  "\", \"base64\").toString(\"utf8\") || \".\";\nfunction escapeRegExp(value) { return value.replace(/[|\\\\{}()[\\]^$+?.]/g, '\\\\$&'); }\nfunction segmentMatcher(segment) {\n  const source = [...segment].map((char) => char === '*' ? '[^/]*' : char === '?' ? '[^/]' : escapeRegExp(char)).join('');\n  return new RegExp(`^${source}$`);\n}\nfunction matches(patternValue, relativePath) {\n  const patternParts = patternValue.split('/').filter(Boolean);\n  const pathParts = relativePath.split('/').filter(Boolean);\n  const matchAt = (patternIndex, pathIndex) => {\n    if (patternIndex === patternParts.length) return pathIndex === pathParts.length;\n    const part = patternParts[patternIndex];\n    if (part === '**') {\n      for (let next = pathIndex; next <= pathParts.length; next += 1) {\n        if (matchAt(patternIndex + 1, next)) return true;\n      }\n      return false;\n    }\n    return pathIndex < pathParts.length && segmentMatcher(part).test(pathParts[pathIndex]) && matchAt(patternIndex + 1, pathIndex + 1);\n  };\n  return matchAt(0, 0);\n}\nfunction walk(dir, prefix = '') {\n  let entries;\n  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return []; }\n  const out = [];\n  for (const entry of entries) {\n    const rel = prefix ? `${prefix}/${entry.name}` : entry.name;\n    const full = path.join(dir, entry.name);\n    if (entry.isDirectory()) out.push(...walk(full, rel));\n    else if (entry.isFile()) {\n      let mtimeMs = 0;\n      try { mtimeMs = fs.statSync(full).mtimeMs; } catch {}\n      out.push({ rel, mtimeMs });\n    }\n  }\n  return out;\n}\nconst entries = walk(root).filter((entry) => matches(pattern, entry.rel)).sort((a, b) => b.mtimeMs - a.mtimeMs);\nprocess.stdout.write(entries.length > 0 ? `${entries.map((entry) => entry.rel).join('\\n')}\\n` : 'No files found\\n');\nNODEEOF"]

/-- `editScript` around its three base64 arguments and the replaceAll flag. -/
def editScriptParts : List String := [
  "node <<'NODEEOF'\nconst fs = require('node:fs');\nconst path = Buffer.from(\"",
  "\", \"base64\").toString(\"utf8\");\nconst oldString = Buffer.from(\"",
  "\", \"base64\").toString(\"utf8\");\nconst newString = Buffer.from(\"",
  "\", \"base64\").toString(\"utf8\");\nconst replaceAll = ",
  ";\nfunction fail(message) { process.stderr.write(message + '\\n'); process.exit(1); }\nif (oldString.length === 0) fail('Error: old_string must not be empty');\nif (oldString === newString) fail('Error: old_string and new_string are identical');\nlet data;\ntry {\n  data = fs.readFileSync(path, 'utf8');\n} catch (error) {\n  if (error && error.code === 'ENOENT') fail(`Error: file not found: ${path}`);\n  throw error;\n}\nconst count = data.split(oldString).length - 1;\nif (count === 0) fail(`Error: old_string not found in ${path}`);\nif (!replaceAll && count > 1) fail(`Error: old_string is not unique (${count} matches); add context or set replace_all`);\nconst updated = replaceAll ? data.split(oldString).join(newString) : data.replace(oldString, newString);\nconst fd = fs.openSync(path, 'w');\ntry { fs.writeSync(fd, updated, null, 'utf8'); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }\nconst replacements = replaceAll ? count : 1;\nprocess.stdout.write(`Edited ${path} (${replacements} replacement${replacements === 1 ? '' : 's'})\\n`);\nNODEEOF"]

/-- `APPLY_SCRIPT`, file-operation.ts:7. -/
def applyScript : String := "\nconst fs = require('node:fs');\nconst nodePath = require('node:path');\nconst op = JSON.parse(Buffer.from(fs.readFileSync(0, 'utf8'), 'base64').toString('utf8'));\nfunction fail(message) { process.stderr.write(message + '\\n'); process.exit(1); }\nfunction diffLines(diff) {\n  const lines = diff.split('\\n');\n  if (lines.at(-1) === '') lines.pop();\n  return lines.filter((line) => line !== '*** End of File');\n}\nfunction save(path, text) {\n  fs.mkdirSync(nodePath.dirname(path), { recursive: true });\n  const fd = fs.openSync(path, 'w');\n  try { fs.writeSync(fd, text, null, 'utf8'); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }\n}\nfunction find(lines, block, from) {\n  const forms = [(s) => s, (s) => s.trimEnd(), (s) => s.trim()];\n  for (const form of forms) {\n    for (let at = from; at + block.length <= lines.length; at++) {\n      if (block.every((line, i) => form(lines[at + i]) === form(line))) return at;\n    }\n  }\n  return -1;\n}\nfunction update(text, diff) {\n  const lines = text.split('\\n');\n  const chunks = [];\n  let chunk;\n  for (const line of diffLines(diff)) {\n    if (line.startsWith('@@')) { chunk = { anchor: line.slice(2).trim(), ops: [] }; chunks.push(chunk); continue; }\n    if (!chunk) { chunk = { anchor: '', ops: [] }; chunks.push(chunk); }\n    chunk.ops.push({ kind: line[0] === '+' || line[0] === '-' ? line[0] : ' ', text: line.slice(1) });\n  }\n  let cursor = 0;\n  for (const { anchor, ops } of chunks) {\n    const old = ops.filter((o) => o.kind !== '+').map((o) => o.text);\n    if (anchor) {\n      const at = lines.findIndex((line, i) => i >= cursor && line.trim() === anchor);\n      if (at < 0) fail('Error: context not found: ' + anchor);\n      cursor = at + 1;\n    }\n    const end = lines.at(-1) === '' ? lines.length - 1 : lines.length;\n    const at = old.length === 0 ? (anchor ? cursor : end) : find(lines, old, cursor);\n    if (at < 0) fail('Error: patch does not match ' + op.path + ' near: ' + old.slice(0, 3).join(' / '));\n    // A context line keeps the file's own spelling: a fuzzy match may differ in whitespace.\n    const added = [];\n    let from = at;\n    for (const o of ops) {\n      if (o.kind === '+') added.push(o.text);\n      else if (o.kind === ' ') added.push(lines[from++]);\n      else from++;\n    }\n    lines.splice(at, old.length, ...added);\n    cursor = at + added.length;\n  }\n  return lines.join('\\n');\n}\nif (op.type === 'delete_file') {\n  try { fs.unlinkSync(op.path); } catch (error) { fail('Error: ' + error.message); }\n  process.stdout.write('Deleted ' + op.path + '\\n');\n} else if (op.type === 'insert') {\n  let text;\n  try { text = fs.readFileSync(op.path, 'utf8'); } catch { fail('Error: file not found: ' + op.path); }\n  const lines = text.split('\\n');\n  const endsWithNewline = lines.at(-1) === '';\n  if (endsWithNewline) lines.pop();\n  if (!Number.isInteger(op.line) || op.line < 0 || op.line > lines.length) {\n    fail('Error: insert_line ' + op.line + ' is outside 0..' + lines.length + ' in ' + op.path);\n  }\n  const added = op.text.split('\\n');\n  if (added.at(-1) === '') added.pop();\n  lines.splice(op.line, 0, ...added);\n  save(op.path, lines.join('\\n') + (endsWithNewline ? '\\n' : ''));\n  process.stdout.write('Inserted after line ' + op.line + ' of ' + op.path + '\\n');\n} else if (op.type === 'create_file') {\n  if (fs.existsSync(op.path)) fail('Error: ' + op.path + ' already exists');\n  const lines = diffLines(op.diff).map((line) => (line.startsWith('+') ? line.slice(1) : line));\n  save(op.path, lines.join('\\n') + '\\n');\n  process.stdout.write('Created ' + op.path + '\\n');\n} else {\n  let text;\n  try { text = fs.readFileSync(op.path, 'utf8'); } catch { fail('Error: file not found: ' + op.path); }\n  save(op.path, update(text, op.diff));\n  process.stdout.write('Updated ' + op.path + '\\n');\n}\n"

