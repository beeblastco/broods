{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": ["warn", 20],
    "object-shorthand": ["error", "never"],
    "typescript/explicit-module-boundary-types": "error"
  },
  "overrides": [
    {
      "files": ["apps/dashboard/**"],
      "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "react",
        "jsx-a11y",
        "nextjs"
      ],
      "jsPlugins": ["@shadcn/lint"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^(AvatarFallback|Badge|Button|ContextMenuLabel|DialogDescription|DropdownMenuLabel|Label|SelectItem|SelectTrigger|Textarea)$",
                "allow": ["layout", "typography"]
              },
              {
                "pattern": "^(InputGroup|InputGroupAddon|InputGroupButton|InputGroupTextarea)$",
                "allow": ["layout", "typography", "spacing", "shape"]
              },
              {
                "pattern": "^(DialogTitle|SheetTitle)$",
                "allow": ["layout", "typography", "gap"]
              },
              {
                "pattern": "^Input$",
                "allow": ["layout", "typography", "pl"]
              },
              {
                "pattern": "^(DialogContent|DialogHeader|TabsList)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "color", "shape"]
              },
              {
                "pattern": "^(Collapsible|CollapsibleContent|CollapsibleTrigger|ContextMenuTrigger|DialogClose|DialogTrigger|DropdownMenuTrigger|ResizablePanel|ResizablePanelGroup|SheetClose|SheetTrigger|TabsContent)$",
                "allow": [
                  "layout",
                  "color",
                  "typography",
                  "spacing",
                  "shape",
                  "effects",
                  "motion"
                ]
              }
            ]
          }
        ],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
        "shadcn/no-inline-styles": "error",
        "shadcn/require-static-classes": "error",
        "shadcn/no-unknown-classes": [
          "error",
          { "allow": ["nodrag", "nopan"] }
        ],
        "react/exhaustive-deps": "warn",
        "react/set-state-in-effect": "warn",
        "nextjs/no-img-element": "warn",
        "jsx-a11y/anchor-has-content": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/control-has-associated-label": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/no-noninteractive-element-interactions": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn"
      }
    },
    {
      "files": ["apps/dashboard/app/components/ui/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["apps/dashboard/tests/**"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-unsafe-optional-chaining": "off",
        "require-yield": "off"
      }
    },
    {
      "files": ["apps/core/sst.config.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".claude/**",
    "**/.docusaurus/**",
    "**/.next/**",
    "**/.sst/**",
    "**/_generated/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/*.d.ts"
  ]
}
