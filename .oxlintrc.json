{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "jsPlugins": ["./oxlint-plugin-broods/index.ts"],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    "broods/no-ad-hoc-type-guards": [
      "error",
      {
        "allow": [
          {
            "file": "packages/convex/model/modelsDev.ts",
            "name": "isPlainObject"
          }
        ]
      }
    ],
    "broods/no-focused-tests": "error",
    "broods/no-inline-schema-compile": "error",
    "broods/no-low-value-comments": "error",
    "broods/no-test-in-loop": "error",
    "broods/require-skip-reason": "error",
    "broods/require-suppression-reason": "error",
    "complexity": ["warn", 20],
    "eslint/accessor-pairs": "error",
    "eslint/array-callback-return": "error",
    "eslint/block-scoped-var": "error",
    "eslint/max-nested-callbacks": "error",
    "eslint/no-array-constructor": "error",
    "eslint/no-await-in-loop": "off",
    "eslint/no-case-declarations": "error",
    "eslint/no-constructor-return": "error",
    "eslint/no-else-return": "error",
    "eslint/no-extend-native": "error",
    "eslint/no-extra-bind": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-inner-declarations": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-new": "error",
    "eslint/no-new-wrappers": "error",
    "eslint/no-object-constructor": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-concat": "error",
    "eslint/no-warning-comments": "error",
    "eslint/radix": "error",
    "eslint/symbol-description": "error",
    "import/no-absolute-path": "error",
    "import/no-cycle": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-self-import": "error",
    "object-shorthand": ["error", "never"],
    "oxc/approx-constant": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-async-endpoint-handlers": "error",
    "oxc/no-map-spread": "off",
    "oxc/no-this-in-exported-function": "error",
    "promise/no-multiple-resolved": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-generated-empty-object-type": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/related-getter-setter-pairs": "error",
    "unicorn/consistent-assert": "error",
    "unicorn/consistent-empty-array-spread": "error",
    "unicorn/no-accessor-recursion": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-new-buffer": "error",
    "unicorn/no-this-assignment": "error",
    "unicorn/no-unnecessary-array-flat-depth": "error",
    "unicorn/no-unnecessary-array-splice-count": "error",
    "unicorn/no-unnecessary-slice-end": "error",
    "unicorn/no-unreadable-iife": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-dom-node-remove": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-prototype-methods": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/require-module-specifiers": "error",
    "unicorn/require-number-to-fixed-digits-argument": "error",
    "unicorn/require-post-message-target-origin": "error"
  },
  "overrides": [
    {
      "files": ["apps/dashboard/**"],
      "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "react",
        "jsx-a11y",
        "nextjs"
      ],
      "jsPlugins": ["@shadcn/lint"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^(AvatarFallback|Badge|Button|ContextMenuLabel|DialogDescription|DropdownMenuLabel|Label|SelectItem|SelectTrigger|Textarea)$",
                "allow": ["layout", "typography"]
              },
              {
                "pattern": "^(InputGroup|InputGroupAddon|InputGroupButton|InputGroupTextarea)$",
                "allow": ["layout", "typography", "spacing", "shape"]
              },
              {
                "pattern": "^(DialogTitle|SheetTitle)$",
                "allow": ["layout", "typography", "gap"]
              },
              {
                "pattern": "^Input$",
                "allow": ["layout", "typography", "pl"]
              },
              {
                "pattern": "^(DialogContent|DialogHeader|TabsList)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "color", "shape"]
              },
              {
                "pattern": "^(Collapsible|CollapsibleContent|CollapsibleTrigger|ContextMenuTrigger|DialogClose|DialogTrigger|DropdownMenuTrigger|ResizablePanel|ResizablePanelGroup|SheetClose|SheetTrigger|TabsContent)$",
                "allow": [
                  "layout",
                  "color",
                  "typography",
                  "spacing",
                  "shape",
                  "effects",
                  "motion"
                ]
              }
            ]
          }
        ],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
        "shadcn/no-inline-styles": "error",
        "shadcn/require-static-classes": "error",
        "shadcn/no-unknown-classes": [
          "error",
          { "allow": ["nodrag", "nopan"] }
        ],
        "react/capitalized-calls": "error",
        "react/checked-requires-onchange-or-readonly": "error",
        "react/display-name": "error",
        "react/exhaustive-deps": "error",
        "react/iframe-missing-sandbox": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-script-url": "error",
        "react/jsx-no-target-blank": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/no-array-index-key": "error",
        "react/no-namespace": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unstable-nested-components": "error",
        "react/rules-of-hooks": "error",
        "react/set-state-in-effect": "error",
        "react/style-prop-object": "error",
        "nextjs/no-img-element": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/control-has-associated-label": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/no-autofocus": "error",
        "jsx-a11y/no-noninteractive-element-interactions": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/prefer-tag-over-role": "error"
      }
    },
    {
      "files": ["apps/dashboard/**"],
      "excludeFiles": [
        "apps/dashboard/e2e/**",
        "apps/dashboard/tests/**",
        "**/*.test.{ts,tsx}"
      ],
      "rules": {
        "broods/no-backdrop-blur": "error",
        "broods/no-continuous-animation": "error",
        "broods/no-hookless-use-function": "error",
        "broods/no-layout-transition": "error",
        "broods/no-unreasoned-state-sync": "error",
        "broods/no-unscoped-has": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "ResizeObserver",
            "message": "Use observeResize (app/lib/observeResize.ts): one shared observer for every element."
          }
        ]
      }
    },
    {
      "files": ["apps/dashboard/app/lib/observeResize.ts"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": ["apps/dashboard/app/components/ui/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["apps/dashboard/tests/**"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "broods/no-inline-schema-compile": "off",
        "no-unsafe-optional-chaining": "off",
        "typescript/no-extraneous-class": "off",
        "require-yield": "off",
        "typescript/await-thenable": "off"
      }
    },
    {
      "files": ["packages/broods/src/**"],
      "rules": {
        "broods/no-low-value-comments": ["error", { "maxLines": 6 }]
      }
    },
    {
      "files": ["apps/core/sst.config.ts"],
      "rules": {
        "eslint/no-new": "off",
        "typescript/triple-slash-reference": "off",
        "no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "SST runs sst.config.ts in Node; use a lazy node: import."
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    ".claude/**",
    "**/.docusaurus/**",
    "**/.next/**",
    "**/.sst/**",
    "**/_generated/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/*.d.ts"
  ]
}
