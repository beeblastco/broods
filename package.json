{
  "name": "broods",
  "description": "Serverless, multi-account AI agent harness built on AWS Lambda and Bun. The open-source engine behind Broods.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0-canary.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/node": "26.1.1",
    "tar": "7.5.22",
    "webpack": "5.109.0"
  },
  "scripts": {
    "build": "bun run --filter @broods/core build",
    "check": "bun run --filter @broods/core check && bun run --filter @broods/convex check && bun run --filter broods check && bun run --filter @broods/ai-sdk-sandbox check && bun run scripts:check",
    "deps:check": "bun scripts/dependency-watch.ts",
    "scripts:check": "tsc -p scripts/tsconfig.json",
    "test": "bun run --filter @broods/core test && bun run --filter @broods/convex test",
    "deploy": "bun run --filter @broods/core deploy",
    "dashboard": "bun run --filter @broods/dashboard dev",
    "dashboard:build": "bun run --filter @broods/dashboard build",
    "docs": "bun run --filter @broods/docs start",
    "docs:build": "bun run --filter @broods/docs build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@ai-sdk/harness-claude-code@1.0.48": "patches/@ai-sdk%2Fharness-claude-code@1.0.48.patch",
    "@ai-sdk/harness-codex@1.0.49": "patches/@ai-sdk%2Fharness-codex@1.0.49.patch",
    "e2b@2.36.0": "patches/e2b@2.36.0.patch"
  }
}
