{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "noEmit": true,
    "paths": {
      "@broods/ai-sdk-sandbox": ["../packages/ai-sdk-sandbox/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  // fixtures/project is a user-style broods project the CLI cases compile; its
  // `broods` import resolves through a link the cases create at setup, not
  // through the workspace, so it is not part of the suite's own typecheck.
  "exclude": ["node_modules", "fixtures/project"]
}
