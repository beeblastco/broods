# Demo runtime settings. Copy into a demo's own folder as `.env.local`.
# Bun loads `.env` then `.env.local` from the folder it runs in, never a parent.

# Where the SDK sends traffic. Unset -> the SDK default host gateway.broods.app.
# Point at a locally-run core to test the container end-to-end:
#   BROODS_BASE_URL=http://localhost:3000
# (Run the core first: `cd apps/core && bun run serve`. See apps/core/.env.example.)
# For the deployed dev gateway instead: BROODS_BASE_URL=https://gateway.dev.broods.app
# BROODS_BASE_URL=http://localhost:3000

# Runtime key for the account the demo agent belongs to. `bun run dev`/`deploy`
# writes this automatically for the selected stage; set it by hand when
# pointing BROODS_BASE_URL at a local/self-hosted core.
# BROODS_API_KEY=fp_agent_...

# Account secret, for the demos that call account routes (cron, channel-records).
# BROODS_ACCOUNT_SECRET=fp_acct_...

# Gateway host the multi-channel register script builds webhook URLs from.
# BROODS_HOST=https://gateway.broods.app

# ── Account env values ─────────────────────────────────────────────
# Agent configs reference these with env("NAME"). `bun run dev` pushes the
# matching values from `.env.local` to the stage; `broods env set` does it by hand.

# Model providers.
# AI_API_KEY=
# AI_BASE_URL=
# BEDROCK_API_KEY=
# GOOGLE_API_KEY=

# webhook: where lifecycle events are POSTed, and the HMAC signing secret.
# WEBHOOK_URL=
# WEBHOOK_SECRET=

# multi-channel: the HubSpot MCP server.
# HUBSPOT_API_TOKEN=

# Sandbox demos: a config env var the sandbox examples read back.
# SANDBOX_SMOKE_VAR=

# Sandbox provider demos (Daytona / Vercel / E2B).
# DAYTONA_API_KEY=
# DAYTONA_ORGANIZATION_ID=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# E2B_API_KEY=
# E2B_TEMPLATE=

# Channel demos. multi-channel and the channel-* register scripts read some of
# these locally too.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_BOT_USERNAME=
# GITHUB_INSTALLATION_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_USER_ID=
# DISCORD_PUBLIC_KEY=
# PANCAKE_PAGE_ACCESS_TOKEN=
# PANCAKE_PAGE_ID=
# PANCAKE_SENDER_ID=
# PANCAKE_WEBHOOK_SECRET=
# ZALO_BOT_TOKEN=
# ZALO_WEBHOOK_SECRET=

# ── Local-only settings ────────────────────────────────────────────
# Read by the demo scripts and broods/ files, never pushed to the stage.

# cron: schedule for the demo job.
# CRON_SCHEDULE_EXPRESSION=

# multi-channel: rooms the agent answers in, and the register script's extras.
# SLACK_GENERAL_CHANNEL_ID=
# SLACK_OPS_CHANNEL_ID=
# TELEGRAM_PRIMARY_CHAT_ID=
# TELEGRAM_SECONDARY_CHAT_ID=
# SLACK_REACTION_EMOJI=eyes
# SLACK_APP_ID=
# SLACK_APP_NAME=Broods demo
# SLACK_APP_TOKEN=
# SLACK_CONFIG_TOKEN=
# SLACK_CONFIG_REFRESH_TOKEN=
# GITHUB_API_URL=
# GITHUB_GIT_USER_EMAIL=

# channel-records: two agents of one account and the Slack rooms bound to them.
# ENG_AGENT_ID=
# SALES_AGENT_ID=
# SLACK_TEAM_ID=
# SLACK_ENG_CHANNEL_ID=
# SLACK_SALES_CHANNEL_ID=
# ONCALL_SLACK_IDS=

# channel-discord register script.
# DISCORD_APPLICATION_ID=
# DISCORD_SYNC_GUILD_ID=

# channel-zalo: allowed user ids, and the webhook URL `bun run dev` printed,
# which its register script hands to Zalo.
# ZALO_ALLOWED_USER_IDS=
# CHANNEL_WEBHOOK_URL=
