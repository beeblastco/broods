{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": ".dts-temp",
    "rootDir": "../..",
    // Resolve to source so the rolled-up .d.ts inlines the name union; left
    // bare it imports a private package no `npm i broods` consumer can resolve.
    "paths": {
      "@broods/convex/model/modelProviders": [
        "../convex/model/modelProviders.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"]
}
