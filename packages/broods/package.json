{
  "name": "broods",
  "version": "0.14.0",
  "description": "CLI + TypeScript SDK for the broods agent platform.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/beeblastco/broods#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeblastco/broods.git",
    "directory": "packages/broods"
  },
  "bugs": {
    "url": "https://github.com/beeblastco/broods/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "sdk",
    "cli",
    "broods"
  ],
  "bin": {
    "broods": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "typesVersions": {
    "*": {
      "account": [
        "./dist/account.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts && rollup -c rollup.dts.config.mjs && rm -rf .dts-temp",
    "check": "tsc --noEmit",
    "pack:check": "bun run build && publint && attw --pack .",
    "test": "bun test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "ai": "^7.0.65"
  },
  "devDependencies": {
    "@ai-sdk/tui": "^1.0.59",
    "@arethetypeswrong/cli": "^0.18.5",
    "@chat-adapter/discord": "^4.35.0",
    "@chat-adapter/github": "^4.35.0",
    "@chat-adapter/slack": "^4.35.0",
    "@chat-adapter/telegram": "^4.35.0",
    "@types/bun": "^1.3.14",
    "ai": "^7.0.65",
    "publint": "^0.3.23",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3"
  }
}
