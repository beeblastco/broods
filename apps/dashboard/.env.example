# Convex deployment the app connects to (the convex CLI itself runs from
# packages/convex with its own .env.local).
NEXT_PUBLIC_CONVEX_URL=
# The *.convex.site URL the CLI proxy route advertises. Optional against Convex
# Cloud, where it is derived from NEXT_PUBLIC_CONVEX_URL; required against a
# self-hosted backend, which has no derivable HTTP-actions host.
# CONVEX_SITE_URL=

# WorkOS AuthKit (read by @workos-inc/authkit-nextjs).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
WORKOS_COOKIE_PASSWORD=

# The gateway in front of the core this dashboard's Convex points at, e.g.
# https://gateway.dev.broods.app. Required outside a production build; the
# Test tab, observability stream, and sandbox terminal all dial it.
NEXT_PUBLIC_BROODS_BASE_URL=
# Optional: shown in the org settings API access panel.
# NEXT_PUBLIC_BROODS_HARNESS_URL=

# Signed-in browser suites (`bun run test:app`, `bun run perf`): the probe
# account, a WorkOS user with email + password auth. scripts/setup-dashboard-e2e.sh
# fills these. E2E_BASE_URL is optional (default http://localhost:3000).
# E2E_EMAIL=
# E2E_PASSWORD=
