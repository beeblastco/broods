{
  "name": "@broods/docs",
  "description": "Broods developer documentation site (Docusaurus).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "DOCUSAURUS_BROWSER=none NODE_OPTIONS=--openssl-legacy-provider docusaurus start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider docusaurus build",
    "serve": "DOCUSAURUS_BROWSER=none docusaurus serve",
    "deploy": "NODE_OPTIONS=--openssl-legacy-provider docusaurus deploy",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@scalar/docusaurus": "^0.8.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/types": "3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@types/node": "^26.1.1",
    "webpack": "5.109.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
