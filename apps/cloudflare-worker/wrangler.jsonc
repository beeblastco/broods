{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broods-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  // `sst deploy` names it per stage. The infra repo puts WORKER_API_KEY on it,
  // which core sends as CLOUDFLARE_WORKER_API_KEY; until then it refuses every call.
  "worker_loaders": [{ "binding": "LOADER" }],
  // A reserved sandbox's files between calls, one object per sandbox id.
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "broods-worker-state" }],
  // `bun run build` writes the runtime the isolates run; the host ships it as text.
  "rules": [{ "type": "Text", "globs": ["**/*.txt"] }],
  "observability": { "enabled": true },
}
