{
  "name": "@broods/core",
  "private": true,
  "description": "Multi-account AI agent harness. One Bun container on the Vercel AI SDK with Google, OpenAI, Bedrock, and Vercel providers, plus channel integrations for Telegram, Discord, Slack, GitHub, Linear, Pancake, Zalo, WhatsApp, Teams, Google Chat, and Twilio. AWS resources deployed with SST.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "postinstall": "bun run scripts/compaction-prompt.ts && if [ -f .env ] || [ -n \"$AWS_ACCOUNT_ID\" ]; then sst install; else echo 'Skipping sst install: set AWS_ACCOUNT_ID, PROJECT_NAME and PROJECT_OWNER_EMAIL (apps/core/.env) first.'; fi",
    "dev": "bun run scripts/compaction-prompt.ts && sst dev",
    "serve": "bun run scripts/compaction-prompt.ts && bun run src/server.ts",
    "build": "bun run scripts/build.ts",
    "check": "bun run scripts/compaction-prompt.ts && bunx tsc --noEmit",
    "test": "bun run scripts/compaction-prompt.ts && bun test --isolate --max-concurrency=1",
    "perf:harness": "bun run scripts/compaction-prompt.ts && bun run scripts/harness-turns-perf.ts",
    "test:coverage": "bun run scripts/compaction-prompt.ts && bun test --isolate --coverage --max-concurrency=1",
    "daytona:s3-snapshot": "bun run scripts/daytona-s3-snapshot.ts",
    "deploy": "bun run build && sst deploy",
    "remove": "sst remove"
  },
