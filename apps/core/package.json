{
  "name": "@broods/core",
  "private": true,
  "description": "Multi-account AI agent harness. One Bun container on the Vercel AI SDK with Google, OpenAI, Bedrock, and Vercel providers, plus channel integrations for Telegram, Discord, Slack, GitHub, Pancake, and Zalo. AWS resources deployed with SST.",
  "type": "module",
  "scripts": {
    "postinstall": "bun run scripts/compaction-prompt.ts && sst install",
    "dev": "bun run scripts/compaction-prompt.ts && sst dev",
    "serve": "bun run scripts/compaction-prompt.ts && bun run src/server.ts",
    "build": "bun run scripts/build.ts",
    "check": "bun run scripts/compaction-prompt.ts && bunx tsc --noEmit",
    "test": "bun test --max-concurrency=1",
    "test:coverage": "bun test --coverage --max-concurrency=1",
    "daytona:s3-snapshot": "bun run scripts/daytona-s3-snapshot.ts",
    "deploy": "bun run build && sst deploy",
    "remove": "sst remove"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.76",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/azure": "^4.0.63",
