{
  "name": "@broods/core",
  "description": "Serverless multi-account AI agent harness on AWS Lambda — Vercel AI SDK with Google, OpenAI, Bedrock, and Gateway providers + multi-channel integrations (Telegram, Discord, Slack, GitHub, Pancake, Zalo), deployed with SST.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "bun run scripts/compaction-prompt.ts && sst install",
    "dev": "bun run scripts/compaction-prompt.ts && sst dev",
    "serve": "bun run scripts/compaction-prompt.ts && bun run src/server.ts",
    "build": "bun run scripts/build.ts",
    "check": "bun run scripts/compaction-prompt.ts && bunx tsc --noEmit",
    "test": "bun test --max-concurrency=1",
    "daytona:s3-snapshot": "bun run scripts/daytona-s3-snapshot.ts",
    "deploy": "bun run build && sst deploy",
    "remove": "sst remove"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.31",
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/gateway": "^4.0.28",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/otel": "^1.0.37",
    "@ai-sdk/policy-opa": "^1.0.37",
    "@ai-sdk/provider": "^4.0.3",
    "@aws-sdk/client-cloudwatch-logs": "^3.1095.0",
    "@aws-sdk/client-lambda": "3.1095.0",
    "@aws-sdk/client-lambda-microvms": "^3.1095.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-ssm": "^3.1095.0",
    "@aws-sdk/client-sts": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@broods/convex": "workspace:*",
    "@chat-adapter/discord": "^4.35.0",
    "@chat-adapter/github": "^4.35.0",
    "@chat-adapter/slack": "^4.35.0",
    "@chat-adapter/telegram": "^4.35.0",
    "@convex-dev/stripe": "^0.1.6",
    "@convex-dev/workos-authkit": "^0.2.7",
    "@daytona/sdk": "^0.200.1",
    "@mv37/workdir": "^0.3.2",
    "@open-policy-agent/opa": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@pulumi/aws": "7.39.0",
    "@pulumi/pulumi": "3.254.0",
    "@smithy/fetch-http-handler": "^5.6.11",
    "@vercel/sandbox": "^2.9.0",
    "ai": "^7.0.37",
    "chat": "^4.35.0",
    "convex": "^1.42.3",
    "e2b": "^2.36.0",
    "nats": "^2.29.3",
    "nats.ws": "^1.30.3",
    "sst": "4.17.1",
    "vercel-minimax-ai-provider": "^0.0.2"
  }
}
