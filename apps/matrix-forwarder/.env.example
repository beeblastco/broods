# Config planes to read Matrix connections from, as a JSON array. The same list
# and deploy-key convention as apps/discord-forwarder: one process serves every
# plane, so the same account deployed to two stages is one sync loop.
BROODS_CONFIG_PLANES=[{"name":"dev","convexUrl":"https://your-deployment.convex.cloud","webhookBaseUrl":"https://gateway.dev.broods.app"}]

# One admin deploy key per plane, named after it. Plane `dev` reads this one.
CONVEX_DEPLOY_KEY_DEV=dev:your-deployment|...

# Every account's crypto store and sync token live under here. Must survive
# restarts: losing it loses the device keys for encrypted rooms.
MATRIX_STORE_DIR=./.matrix-store

# Local/container bind settings.
PORT=3000
HOSTNAME=0.0.0.0
