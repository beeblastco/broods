# Gateway front door the channel webhooks live behind. Required — the forwarder
# joins the webhook path the config plane returns onto this.
BROODS_WEBHOOK_BASE_URL=https://gateway.dev.broods.app

# Config plane. Same pair core uses; the deploy key is admin auth, so the
# forwarder reads Discord bot tokens without holding the encryption secret.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=dev:your-deployment|...

# Local/container bind settings.
PORT=3000
HOSTNAME=0.0.0.0

# How often the socket set is reconciled against the config plane.
DISCORD_POLL_INTERVAL_MS=30000

# Reconnect pacing. The ceiling is the primary guard on Discord's per-token
# IDENTIFY allowance (1000 per 24h, past which the bot token is reset): at 300s
# a permanently failing socket spends under 300 a day.
DISCORD_BACKOFF_BASE_MS=1000
DISCORD_BACKOFF_CEILING_MS=300000

# Per-token IDENTIFY accounting, the belt to that pair of braces. Half of
# Discord's 1000 leaves room for a pod restart, which forgets the counter.
DISCORD_IDENTIFY_LIMIT=500
DISCORD_IDENTIFY_WINDOW_MS=86400000
