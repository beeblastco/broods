# Config planes to read Discord connections from, as a JSON array. One process
# serves every plane rather than one process per stage: a socket belongs to a bot
# token, so two forwarders that both saw a token would each hold a socket for it
# and every message would be answered twice.
BROODS_CONFIG_PLANES=[{"name":"dev","convexUrl":"https://your-deployment.convex.cloud","webhookBaseUrl":"https://gateway.dev.broods.app"}]

# One admin deploy key per plane, named after it — plane `dev` reads this one.
# The deploy key is admin auth, so the forwarder reads Discord bot tokens without
# ever holding the encryption secret.
CONVEX_DEPLOY_KEY_DEV=dev:your-deployment|...

# Local/container bind settings.
PORT=3000
HOSTNAME=0.0.0.0

# How often the socket set is reconciled against the config plane.

# Reconnect ceiling and per-token IDENTIFY allowance. Both bound how fast the
# forwarder may re-IDENTIFY; `src/identify-budget.ts` says why that matters.
DISCORD_BACKOFF_CEILING_MS=300000
DISCORD_IDENTIFY_LIMIT=500
